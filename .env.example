# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Connect button -> Transaction pooler (port 6543). Runtime jobs; needs prepare: false.
# SERVER ONLY. Bypasses RLS.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Connect button -> Session pooler (port 5432) or Direct connection. Used by drizzle-kit migrations.
DIRECT_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Market data source: "demo" (simulated prices) or "eodhd" (needs EODHD_API_KEY; quotes ~15-20 min delayed)
MARKET_DATA_SOURCE=demo
# https://eodhd.com -> Dashboard -> API token. SERVER ONLY.
EODHD_API_KEY=

# Shared secret for /api/jobs/* (cron). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Connect button -> Transaction pooler (port 6543). Runtime jobs; needs prepare: false.
# SERVER ONLY. Bypasses RLS.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Connect button -> Session pooler (port 5432) or Direct connection. Used by drizzle-kit migrations.
DIRECT_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Market data source: "demo" (simulated prices) or "eodhd" (needs EODHD_API_KEY)
MARKET_DATA_SOURCE=demo
# https://eodhd.com -> Dashboard -> API token. SERVER ONLY.
EODHD_API_KEY=
# EODHD calls allowed per day (UTC). EODHD counts one call per ticker. Free plan: 20/day; keep a margin.
EODHD_DAILY_LIMIT=15
# eod: daily closes (the free plan has no PSX intraday quotes). realtime: quotes ~15-20 min delayed (paid plans).
EODHD_QUOTE_MODE=eod

# Scheduled price refresh. Intraday modes: every N minutes in PSX market hours.
# End-of-day mode: retry every N minutes until the day's closes are published.
PRICE_REFRESH_MINUTES=30
# holdings: stocks someone holds or watches (default). all: every listed stock (too many for the free plan).
PRICE_REFRESH_SCOPE=holdings
# End-of-day mode: first try for a day's closes this many minutes after the close.
EOD_PUBLISH_DELAY_MINUTES=120
# Where the "Refresh prices" button reaches the job endpoint. Set to the deployed URL in production.
JOBS_BASE_URL=http://localhost:3000

# Shared secret for /api/jobs/* (cron). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
